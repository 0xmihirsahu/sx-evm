BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
PRIVATE_KEY_BASE_SEPOLIA=0xYOUR_FUNDED_BASE_SEPOLIA_PRIVATE_KEY

# Optional, required only for `npm run multi-voter` / `npm run all`.
# These voters sign via EthSigAuthenticator, so they do not need ETH.
VOTER_PRIVATE_KEYS=0xVOTER_KEY_ONE,0xVOTER_KEY_TWO

# Optional knobs
VOTE_CHOICE=1
# Blocks the voting window stays open before reveal is allowed. Keep small to limit the post-vote wait.
MAX_VOTING_DURATION=30
INCO_DECRYPT_RETRIES=12
INCO_DECRYPT_RETRY_MS=5000
